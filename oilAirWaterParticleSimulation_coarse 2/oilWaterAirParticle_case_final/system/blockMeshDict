FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }
scale 0.07; // domain shrunk uniformly by 0.07 so bubble/oil/particle stay proportionally sized
// x-extent widened from 0.030 to 0.080 (pre-scale) -> actual Lx grows from 2.1mm to 5.6mm,
// i.e. 8x the 0.7mm bubble diameter (a common rule of thumb for keeping side-wall
// confinement effects small). The original 2.1mm-wide domain (only 3x the bubble
// diameter) let the bubble drift sideways into a wall within ~30ms of the run and
// stall there for most of the simulation instead of rising freely. Cell count in x is
// scaled up proportionally (150->400) to keep the same 14um cell size (dx=dy still).
//
// COARSE DIAGNOSTIC VARIANT: cell counts reduced 4x in both x and y (400->100,
// 500->125), giving dx=dy=56um instead of 14um (same physical domain size,
// unchanged geometry/setFieldsDict). This is NOT the final thesis-quality
// resolution -- the 0.7mm bubble is now only ~12.5 cells across (vs ~50 before)
// and the smallest oil droplet only ~5 cells across, too coarse for accurate
// interface curvature or quantitative results. The point is purely diagnostic
// speed: the explicit-surface-tension capillary time-step limit scales as
// dx^1.5, so 4x coarser cells relax that limit by ~8x, and 16x fewer cells
// also means ~16x less work per timestep -- together this should let the
// solver reach far more simulated time per hour of compute, so you can
// quickly confirm whether the bubble/oil/particles move as expected before
// committing days of runtime to the fine (14um) mesh for final results.
vertices
(
    (0.000  0.000  0.000)
    (0.080  0.000  0.000)
    (0.080  0.100  0.000)
    (0.000  0.100  0.000)
    (0.000  0.000  0.001)
    (0.080  0.000  0.001)
    (0.080  0.100  0.001)
    (0.000  0.100  0.001)
);
blocks ( hex (0 1 2 3 4 5 6 7) (100 125 1) simpleGrading (1 1 1) );
edges ();
boundary
(
    walls       { type wall;  faces ( (0 1 5 4) (0 3 7 4) (1 2 6 5) ); }
    top         { type patch; faces ( (3 2 6 7) ); }
    frontAndBack{ type empty; faces ( (0 1 2 3) (4 5 6 7) ); }
);
