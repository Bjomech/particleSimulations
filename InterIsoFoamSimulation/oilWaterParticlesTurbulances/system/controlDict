FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     turbulentThreePhaseFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         10;

deltaT          1e-4;

writeControl    timeStep;
writeInterval   5;

purgeWrite      0;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           0.25;
maxAlphaCo      0.25;
maxDeltaT       0.001;
