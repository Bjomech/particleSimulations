FoamFile { version 2.0; format ascii; class dictionary; object setFieldsDict; }
defaultFieldValues
(
    volScalarFieldValue alpha.air   0
    volScalarFieldValue alpha.oil   0
    volScalarFieldValue alpha.water 1
);

regions
(
    // Air bubble: R=0.35mm (shrunk by factor 0.07 from original R=5mm), centre scaled accordingly.
    // x-centre = 0.0028 = new domain half-width (Lx=0.0056m), i.e. still exactly centred in x.
    // Domain was widened from 2.1mm to 5.6mm (8x bubble diameter) to reduce side-wall
    // confinement — the 2.1mm case let the bubble drift into a wall almost immediately and
    // stall there for most of the run instead of rising freely; see the wider blockMeshDict.
    // NOTE: the old "rise velocity ~120mm/s -> reaches droplet 1 at t~0.13s" estimate was a
    // stale note from the pre-shrink 5mm-radius bubble and does not apply to this geometry.
    // INJECTION VELOCITY: this simulation models an *injected* air bubble, not
    // one spontaneously appearing at rest. A real injected bubble carries initial
    // momentum from the injection process itself, on top of subsequent buoyant
    // rise. 0.15 m/s (upward, +y, matching corrected gravity direction) is used
    // as a physically grounded starting value: for a ~0.7mm-diameter air bubble
    // in water, both Stokes/rigid-sphere theory (u ~ g*d^2*Delta_rho/(18*mu) =~
    // 0.27 m/s) and Hadamard-Rybczynski mobile-interface theory (~0.3-0.4 m/s)
    // land in the same 0.1-0.3 m/s range, and this bubble size sits right at the
    // documented threshold below which small air bubbles stay spherical and rise
    // rectilinearly (Saffman 1956, ~0.7mm). Adjust this single value to match
    // your real injection setup (orifice diameter / flow rate) if known.
    sphereToCell
    {
        centre  (0.0028 0.00105 0.000035);
        radius  0.00035;
        fieldValues
        (
            volScalarFieldValue alpha.air   1
            volScalarFieldValue alpha.oil   0
            volScalarFieldValue alpha.water 0
            volVectorFieldValue U           (0 0.15 0)
        );
    }

    // Oil droplet 1 — scaled by 0.07 (was centre (0.016 0.030 0.0005), radius 0.003)
    sphereToCell
    {
        centre  (0.00287 0.0021 0.000035);
        radius  0.00021;
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.oil   1
            volScalarFieldValue alpha.water 0
        );
    }

    // Oil droplet 2 — scaled by 0.07 (was centre (0.014 0.065 0.0005), radius 0.0025)
    sphereToCell
    {
        centre  (0.00273 0.00455 0.000035);
        radius  0.000175;
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.oil   1
            volScalarFieldValue alpha.water 0
        );
    }

    // Oil droplet 3 — scaled by 0.07 (was centre (0.015 0.085 0.0005), radius 0.002)
    sphereToCell
    {
        centre  (0.0028 0.00595 0.000035);
        radius  0.00014;
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.oil   1
            volScalarFieldValue alpha.water 0
        );
    }
);
