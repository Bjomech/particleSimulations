#!/bin/sh
cd "${0%/*}" || exit 1    # run from this directory

# ---------------------------------------------------------------------------
# Restore a pristine 0/ from 0.orig/ so repeated runs always start from the
# same uniform initial state. setFields overwrites 0/alpha.* in place, so
# without this the second run would set fields on top of already-set fields
# (harmless here, but it also means a stale 0/ can silently survive an
# Allclean and make a run irreproducible).
# ---------------------------------------------------------------------------
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
restore0Dir

# ---------------------------------------------------------------------------
# Detect which solver this case is configured for (system/controlDict),
# so this same Allrun works unmodified for any case/solver.
# ---------------------------------------------------------------------------
application=$(foamDictionary -entry application -value system/controlDict)
if [ -z "$application" ]
then
    echo "ERROR: could not read 'application' from system/controlDict."
    echo "       Are you running this from inside the case directory?"
    exit 1
fi
echo "Solver: $application"

# ---------------------------------------------------------------------------
# Detect available cores: macOS performance cores, else Linux logical cores.
# ---------------------------------------------------------------------------
if command -v sysctl >/dev/null 2>&1 && sysctl -n hw.perflevel0.logicalcpu >/dev/null 2>&1
then
    nProcs=$(sysctl -n hw.perflevel0.logicalcpu)
else
    nProcs=$(nproc 2>/dev/null || echo 1)
fi
echo "Cores detected: $nProcs"

# ---------------------------------------------------------------------------
# Mesh + initial fields (serial)
# ---------------------------------------------------------------------------
blockMesh  > log.blockMesh  2>&1 || { echo "blockMesh FAILED - see log.blockMesh"; exit 1; }
echo "blockMesh done"
setFields  > log.setFields  2>&1 || { echo "setFields FAILED - see log.setFields"; exit 1; }
echo "setFields done"

# ---------------------------------------------------------------------------
# Create or update decomposeParDict with the detected core count
# ---------------------------------------------------------------------------
if [ ! -f system/decomposeParDict ]
then
    cat > system/decomposeParDict << EOF
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}

numberOfSubdomains  $nProcs;
method              scotch;
EOF
    echo "Created system/decomposeParDict ($nProcs subdomains)"
else
    foamDictionary -entry numberOfSubdomains -set "$nProcs" system/decomposeParDict > /dev/null
    echo "Updated system/decomposeParDict ($nProcs subdomains)"
fi

# ---------------------------------------------------------------------------
# Decompose mesh + fields for the parallel run
# ---------------------------------------------------------------------------
decomposePar > log.decomposePar 2>&1 || { echo "decomposePar FAILED - see log.decomposePar"; exit 1; }
echo "decomposePar done"

# ---------------------------------------------------------------------------
# Run the solver in parallel, in the background
# ---------------------------------------------------------------------------
mpirun -np "$nProcs" "$application" -parallel > log.solver 2>&1 &
solverPID=$!
echo "Solver ($application) running in background (PID $solverPID)"
echo "Watch progress:  tail -f log.solver"

# ---------------------------------------------------------------------------
# Wait for the solver to actually finish before doing anything below —
# reconstructing a still-running case produces incomplete/inconsistent data.
# (Run this whole script with "./Allrun &" yourself if you want your
# terminal free while this wait happens.)
# ---------------------------------------------------------------------------
wait "$solverPID"
echo "Solver finished."

# ---------------------------------------------------------------------------
# Sanitize ASCII field files before reconstructing.
#
# OpenFOAM's ASCII writer can leave subnormal near-zero residue (e.g.
# 1.2e-308) in fields like alpha.<phase> after repeated VOF bounding —
# values so close to zero the ASCII reader itself can't always parse them
# back in, which breaks reconstructPar with:
#   "Bad token - could not get scalar value"
# This replaces any such token with a clean 0 across every processor/time
# folder, before reconstructing. It's a no-op if this run has no such values,
# which should now be the case: the original source of the subnormals was the
# global "alpha *= sumBefore/sumAfter" rescale in the old alphaEqn.H, which the
# fixed solver no longer does.
#
# IMPORTANT: this only touches files whose FoamFile header says
# "format ascii". Running a byte-level regex over binary field data would
# corrupt it, so if you ever set writeFormat binary in controlDict the guard
# below skips those files instead of eating them.
# ---------------------------------------------------------------------------
python3 - << 'PYEOF'
import re, glob, os
from collections import Counter

pattern = re.compile(rb'[0-9]\.[0-9]+e-[0-9]{3}')  # matches e-100 .. e-999

files = [f for f in glob.glob('processor*/[0-9]*/**/*', recursive=True)
         if os.path.isfile(f)]
per_field = Counter()
files_touched = 0
skipped_binary = 0

for f in files:
    with open(f, 'rb') as fh:
        data = fh.read()

    # Only touch OpenFOAM field files whose header declares ascii format
    fmt = re.search(rb'format\s+(\w+)\s*;', data[:2000])
    if not fmt:
        continue
    if fmt.group(1) != b'ascii':
        skipped_binary += 1
        continue

    new_data, n = pattern.subn(b'0', data)
    if n:
        with open(f, 'wb') as fh:
            fh.write(new_data)
        per_field[os.path.basename(f)] += n
        files_touched += 1

if per_field:
    total = sum(per_field.values())
    print(f"  sanitized {total} subnormal value(s) across {files_touched} file(s):")
    for fieldName, n in sorted(per_field.items(), key=lambda x: -x[1]):
        print(f"    {fieldName}: {n}")
else:
    print("  no corrupted subnormal values found")

if skipped_binary:
    print(f"  skipped {skipped_binary} non-ascii (binary) field file(s)")
PYEOF

# ---------------------------------------------------------------------------
# Reconstruct the decomposed case into full-domain time folders
# ---------------------------------------------------------------------------
reconstructPar > log.reconstructPar 2>&1
reconstructStatus=$?

# ---------------------------------------------------------------------------
# Create the .foam placeholder ParaView needs to recognize this folder as
# an OpenFOAM case (named after the case folder itself, so this works for
# any case without editing the script).
# ---------------------------------------------------------------------------
caseName=$(basename "$PWD")
touch "${caseName}.foam"

if [ "$reconstructStatus" -eq 0 ]
then
    echo "reconstructPar done"
    echo "Open ${caseName}.foam in ParaView -> Properties -> Case Type: Reconstructed Case"
else
    echo "reconstructPar reported an issue (see log.reconstructPar) — some timesteps may be missing/incomplete"
    echo "You can still visualize the decomposed data directly:"
    echo "  Open ${caseName}.foam in ParaView -> Properties -> Case Type: Decomposed Case"
fi

# ---------------------------------------------------------------------------
# Quick quantitative check: bubble rise velocity + phase-volume conservation.
# This is the first thing to look at before opening ParaView.
# ---------------------------------------------------------------------------
if command -v python3 >/dev/null 2>&1
then
    echo ""
    python3 bubbleRise.py 2>&1 || echo "  (bubbleRise.py needs numpy: pip3 install numpy)"
fi

#------------------------------------------------------------------------------
