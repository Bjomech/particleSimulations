/*---------------------------------------------------------------------------*\
  fvSolution  (FIXED VERSION)

  Changes
  ───────
  1. Relaxation removed. This is a transient PIMPLE run with 3 outer
     correctors; relaxing p_rgh by 0.3 and U by 0.7 damps the physical
     transient (stock interFoam/interIsoFoam use no relaxation at all).
  2. "alpha.*" now controls a MULES-based scheme (alphaEqn.H), not
     isoAdvector. cAlpha is the interface-compression strength (read
     directly by alphaEqn.H). nAlphaSubCycles is kept only as documentation -
     sub-cycling is not implemented in this revision (see alphaEqn.H header
     comment) and the entry is not read. The isoAdvector-only keys that used to live here
     (reconstructionScheme, isoFaceTol, surfCellTol, nAlphaBounds, snapTol,
     clip, writeIsoFaces) have been removed - they are no longer read by
     anything.
  3. Tighter p_rgh relTol during the outer iterations (1e-3 instead of 1e-2),
     and 3 outer correctors: with surface tension in phiHbyA the pressure
     equation has to converge properly or the capillary/pressure balance is
     never reached.
  4. momentumPredictor no - standard choice for surface-tension-dominated VOF;
     switch back to yes if you see the predictor helping.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    "alpha.*"
    {
        cAlpha              1;
        nAlphaSubCycles     1;   // documentation only - not read by alphaEqn.H;
                                  // sub-cycling isn't implemented, see its header

        // Optional ESI MULES limiter tuning, read internally by
        // MULES::limiter from this dict (there is no MULES::control class
        // in ESI v2512 - the keys below are the ESI ones, defaults shown):
        // nLimiterIter        3;
        // extremaCoeff        0;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       1e-5;
            relTol          0;
            smoother        GaussSeidel;
        }
        tolerance       1e-5;
        relTol          0;
        maxIter         50;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          1e-3;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "U.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
        nSweeps         1;
    }
}

PIMPLE
{
    momentumPredictor        no;
    nOuterCorrectors         3;
    nCorrectors              2;
    nNonOrthogonalCorrectors 0;

    // Only used if p_rgh has no fixed-value boundary anywhere (with the
    // totalPressure outlet on "top" it is not needed, but harmless).
    pRefCell                 0;
    pRefValue                0;
}

// No relaxation in a transient VOF run
relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

