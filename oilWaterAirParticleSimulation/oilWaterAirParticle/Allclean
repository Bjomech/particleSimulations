#!/bin/sh
cd "${0%/*}" || exit 1    # Run from this directory

# Source tutorial clean functions (provides cleanCase, etc.)
. "$WM_PROJECT_DIR/bin/tools/CleanFunctions"

# Remove all time directories/logs/postProcessing (standard OpenFOAM
# cleanCase), plus:
#   0           - regenerated from 0.orig by Allrun (restore0Dir), so removing
#                 it guarantees no stale set-fields state survives a clean
#   *.foam      - the ParaView placeholder Allrun creates
cleanCase
rm -rf 0
rm -f ./*.foam

