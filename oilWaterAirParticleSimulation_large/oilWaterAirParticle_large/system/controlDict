FoamFile { version 2.0; format ascii; class dictionary; location "system"; object controlDict; }
application     oilWaterAirParticleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.33;
deltaT          1e-4;
writeControl    adjustableRunTime;
writeInterval   0.002;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       4e-4;
functions
{
    fieldMinMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   10;
        fields          (magU alpha.air alpha.oil alpha.water p_rgh);
    }

    writeDUcDt
    {
        type            DDt;
        libs            (fieldFunctionObjects);
        field           U;
        result          DUcDt;
        writeControl    timeStep;
        writeInterval   1;
    }
}
