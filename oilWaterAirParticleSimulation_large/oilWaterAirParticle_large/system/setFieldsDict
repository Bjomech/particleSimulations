FoamFile { version 2.0; format ascii; class dictionary; object setFieldsDict; }
defaultFieldValues
(
    volScalarFieldValue alpha.air   0
    volScalarFieldValue alpha.oil   0
    volScalarFieldValue alpha.water 1
);

regions
(
    // Air bubble: R=7.5mm, centre 15mm from bottom
    // Rise velocity ~120mm/s → reaches droplet 1 at t≈0.13s
    sphereToCell
    {
        centre  (0.015 0.015 0.0005);
        radius  0.005;
        fieldValues
        (
            volScalarFieldValue alpha.air   1
            volScalarFieldValue alpha.oil   0
            volScalarFieldValue alpha.water 0
        );
    }

    // Oil droplet 1 — 30mm above bubble centre
    sphereToCell
    {
        centre  (0.016 0.030 0.0005);
        radius  0.003;
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.oil   1
            volScalarFieldValue alpha.water 0
        );
    }

    // Oil droplet 2 — 20mm above droplet 1
    sphereToCell
    {
        centre  (0.014 0.065 0.0005);
        radius  0.0025;
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.oil   1
            volScalarFieldValue alpha.water 0
        );
    }

    // Oil droplet 3 — 20mm above droplet 2
    sphereToCell
    {
        centre  (0.015 0.085 0.0005);
        radius  0.002;
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.oil   1
            volScalarFieldValue alpha.water 0
        );
    }
);
